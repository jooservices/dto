{
    "name": "jooservices/dto",
    "description": "PHP 8.5+ DTO and Data library with immutable DTOs and mutable Data objects",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "dto",
        "data-transfer-object",
        "data",
        "hydration",
        "normalization",
        "casting",
        "mapping"
    ],
    "authors": [
        {
            "name": "JOOservices",
            "email": "admin@jooservices.com"
        }
    ],
    "support": {
        "issues": "https://github.com/jooservices/dto/issues",
        "source": "https://github.com/jooservices/dto"
    },
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-libxml": "*",
        "psr/http-message": "^2.0"
    },
    "suggest": {
        "psr/log": "Enables debug logging during DTO hydration via Engine constructor injection."
    },
    "require-dev": {
        "captainhook/captainhook": "^5.23",
        "captainhook/plugin-composer": "^5.3",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.65",
        "laravel/pint": "^1.18",
        "phpbench/phpbench": "^1.6",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "squizlabs/php_codesniffer": "^3.8 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "JOOservices\\Dto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JOOservices\\Dto\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit --coverage-html coverage --coverage-clover coverage.xml",
        "bench": "phpbench run --report=aggregate",
        "lint:pint": "pint --test",
        "lint:pint:fix": "pint",
        "lint:cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "lint:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "lint:phpcs": "phpcs --standard=phpcs.xml",
        "lint:phpstan": "XDEBUG_MODE=off phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
        "lint:phpmd": "php -d error_reporting=6143 vendor/bin/phpmd src text phpmd.xml",
        "lint": [
            "@lint:pint",
            "@lint:phpcs",
            "@lint:phpstan",
            "@lint:phpmd",
            "@lint:cs"
        ],
        "lint:fix": [
            "@lint:pint:fix",
            "@lint:cs:fix"
        ],
        "check": [
            "@lint",
            "@test"
        ],
        "ci": [
            "@lint",
            "@test:coverage"
        ],
        "post-install-cmd": "captainhook install --force --skip-existing",
        "post-update-cmd": "captainhook install --force --skip-existing"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "captainhook/plugin-composer": true
        },
        "audit": {
            "abandoned": "ignore"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
