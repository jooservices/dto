#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! -f "$1" ]]; then
    echo "Usage: commit-msg <message-file>" >&2
    exit 2
fi

SUBJECT="$(head -n 1 "$1")"
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: [A-Z].+$'

if (( ${#SUBJECT} < 10 || ${#SUBJECT} > 120 )) || [[ ! "$SUBJECT" =~ $PATTERN || "$SUBJECT" == *. ]]; then
    echo "Commit header must follow Conventional Commits, use an uppercase subject, be 10–120 characters, and have no trailing period." >&2
    echo "Example: chore: Add Docker quality gates" >&2
    exit 1
fi
