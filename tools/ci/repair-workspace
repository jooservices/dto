#!/usr/bin/env bash
# Fix root-owned vendor/build from legacy Docker runs before actions/checkout clean.
set -euo pipefail

workspace="${GITHUB_WORKSPACE:-${1:-.}}"

if [ ! -d "${workspace}" ]; then
    exit 0
fi

if [ ! -d "${workspace}/vendor" ] && [ ! -d "${workspace}/build" ]; then
    exit 0
fi

docker run --rm -v "${workspace}:/w" alpine chown -R "$(id -u):$(id -g)" /w \
    2>/dev/null \
    || sudo chown -R "$(id -u):$(id -g)" "${workspace}" \
    2>/dev/null \
    || true
