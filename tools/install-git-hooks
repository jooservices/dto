#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

HOOKS_DIR="$(git rev-parse --path-format=absolute --git-path hooks)"

# Installing a worktree-specific hooks path must not silently disable a
# hooksPath configured elsewhere (for example in the user's global config).
CONFIGURED_HOOKS_DIR="$(git config --path --get-all core.hooksPath || true)"
if git config --get-all core.hooksPath >/dev/null; then
    while IFS= read -r configured_hooks_dir; do
        [[ "$configured_hooks_dir" == "$HOOKS_DIR" ]] && continue
        echo "Refusing to replace configured core.hooksPath: $configured_hooks_dir" >&2
        echo "Preserve or explicitly integrate that hooks directory before installing DTO hooks." >&2
        exit 1
    done <<< "$CONFIGURED_HOOKS_DIR"
fi

is_dto_hook() {
    local hook_file="$1"
    local hook_name="$2"
    local hook_target
    local current_wrapper
    local previous_wrapper

    [[ -f "$hook_file" && ! -L "$hook_file" ]] || return 1
    printf -v hook_target '%q' "$ROOT/tools/hooks/$hook_name"

    printf -v current_wrapper '#!/usr/bin/env bash\n# installed by DTO project Docker quality gates\nset -euo pipefail\nexec %s "$@"' "$hook_target"
    printf -v previous_wrapper '#!/usr/bin/env bash\nset -euo pipefail\nexec %s "$@"' "$hook_target"

    local existing_wrapper
    existing_wrapper="$(<"$hook_file")"
    [[ "$existing_wrapper" == "$current_wrapper" || "$existing_wrapper" == "$previous_wrapper" ]]
}

is_obsolete_captainhook() {
    local hook_file="$1"
    [[ -f "$hook_file" && ! -L "$hook_file" ]] || return 1
    grep -Fq '# installed by CaptainHook' "$hook_file" \
        && grep -Fq 'tools/run-captainhook' "$hook_file"
}

# Validate every hook we would replace before changing Git configuration or
# deleting an obsolete generated hook. Unknown hooks are user-owned.
for hook in commit-msg pre-commit pre-push; do
    existing_hook="$HOOKS_DIR/$hook"
    [[ -e "$existing_hook" || -L "$existing_hook" ]] || continue
    is_dto_hook "$existing_hook" "$hook" && continue
    is_obsolete_captainhook "$existing_hook" && continue

    echo "Refusing to replace existing non-DTO Git hook: $existing_hook" >&2
    echo "Preserve or explicitly chain its behavior into the DTO hook, then retry." >&2
    exit 1
done

git config extensions.worktreeConfig true
mkdir -p "$HOOKS_DIR"
git config --worktree core.hooksPath "$HOOKS_DIR"

# Remove only obsolete hooks generated by the previous CaptainHook setup.
# The DTO-owned hooks now provide the required behavior, and CaptainHook's
# runner and configuration are no longer shipped.
for legacy_hook in "$HOOKS_DIR"/*; do
    [[ -f "$legacy_hook" ]] || continue
    if is_obsolete_captainhook "$legacy_hook"; then
        rm -- "$legacy_hook"
    fi
done

for hook in commit-msg pre-commit pre-push; do
    printf -v hook_target '%q' "$ROOT/tools/hooks/$hook"
    printf '#!/usr/bin/env bash\n# installed by DTO project Docker quality gates\nset -euo pipefail\nexec %s "$@"\n' "$hook_target" > "$HOOKS_DIR/$hook"
    chmod +x "$HOOKS_DIR/$hook"
done

echo "Git hooks installed (Docker-backed project gates; hooks directory: $HOOKS_DIR)"
