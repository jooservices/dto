#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

git config extensions.worktreeConfig true
HOOKS_DIR="$(git rev-parse --path-format=absolute --git-path hooks)"
mkdir -p "$HOOKS_DIR"
git config --worktree core.hooksPath "$HOOKS_DIR"

# Remove only obsolete hooks generated by the previous CaptainHook setup.
# The DTO-owned hooks now provide the required behavior, and CaptainHook's
# runner and configuration are no longer shipped.
for legacy_hook in "$HOOKS_DIR"/*; do
    [[ -f "$legacy_hook" ]] || continue
    if grep -Fq '# installed by CaptainHook' "$legacy_hook" \
        && grep -Fq 'tools/run-captainhook' "$legacy_hook"; then
        rm -- "$legacy_hook"
    fi
done

for hook in commit-msg pre-commit pre-push; do
    printf -v hook_target '%q' "$ROOT/tools/hooks/$hook"
    printf '#!/usr/bin/env bash\nset -euo pipefail\nexec %s "$@"\n' "$hook_target" > "$HOOKS_DIR/$hook"
    chmod +x "$HOOKS_DIR/$hook"
done

echo "Git hooks installed (Docker-backed project gates; hooks directory: $HOOKS_DIR)"
