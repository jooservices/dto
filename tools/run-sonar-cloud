#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$ROOT"

if [[ "${GITHUB_ACTIONS:-}" != true ]]; then
    echo "SonarCloud analysis is allowed only inside GitHub Actions." >&2
    exit 1
fi

if [[ -z "${SONAR_TOKEN:-}" ]]; then
    echo "SONAR_TOKEN must be provided by the GitHub Actions secret for CI analysis." >&2
    exit 1
fi

if [[ "${SONAR_HOST_URL:-}" != "https://sonarcloud.io" ]]; then
    echo "SonarCloud CI analysis must target https://sonarcloud.io." >&2
    exit 1
fi

HAS_PR_KEY=false
HAS_PR_BRANCH=false
HAS_PR_BASE=false
for argument in "$@"; do
    case "$argument" in
        -Dsonar.pullrequest.key=*) HAS_PR_KEY=true ;;
        -Dsonar.pullrequest.branch=*) HAS_PR_BRANCH=true ;;
        -Dsonar.pullrequest.base=*) HAS_PR_BASE=true ;;
    esac
done

if [[ "$HAS_PR_KEY" != true || "$HAS_PR_BRANCH" != true || "$HAS_PR_BASE" != true ]]; then
    echo "SonarCloud analysis is restricted to pull requests in GitHub Actions." >&2
    exit 1
fi

export SONAR_LOCAL=false
exec tools/ci/run-sonar-scanner "$@" -Dsonar.organization=jooservices
